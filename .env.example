# LLM API Key (OpenAI API key, Gemini API key, etc.)
LLM_API_KEY=your_llm_api_key_here

# Optional: Model override (e.g. gpt-4o, gemini-3.8-flash, gemini-2.5-flash)
LLM_MODEL=gpt-4o

# Optional: Base URL override (automatically defaults to Gemini endpoint if model contains 'gemini')
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
